{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=GridMeter;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True"
  },
  "Jwt": { "Key": "dev-only-signing-key-change-me-0123456789abcdef" },
  "FeatureManagement": { "tariff-estimates": false },
  "Flags": { "AllowRuntimeToggle": false },
  "PriceApi": { "BaseUrl": "http://localhost:5100" },
  "Messaging": {
    "Enabled": true,
    "AutoCreateQueues": false,
    "ReadingsQueue": "gridmeter-readings",
    "DemandResponseQueue": "gridmeter-dr-events"
  },
  "Storage": { "UploadsBucket": "gridmeter-uploads" },
  "AWS": { "Region": "ap-southeast-2" },
  "Finbuckle": {
    "MultiTenant": {
      "Stores": {
        "ConfigurationStore": {
          "Tenants": [
            { "Id": "aurora-power", "Identifier": "aurora-power", "Name": "Aurora Power" },
            { "Id": "kita-denki", "Identifier": "kita-denki", "Name": "Kita Denki" }
          ]
        }
      }
    }
  }
}
